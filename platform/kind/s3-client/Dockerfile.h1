# H1 S3 client: use a pinned current AWS CLI v2 image rather than updating the
# older 2.31.0 layer in-place. Adoption is gated by the S3 contract and Trivy CI.
FROM amazon/aws-cli:2.37.5
USER 0
RUN yum install -y diffutils \
    && yum clean all \
    && rm -rf /var/cache/yum \
    && aws --version \
    && diff --version >/dev/null
USER 1000:1000
