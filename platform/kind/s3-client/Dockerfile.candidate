# H1 candidate evaluation only. A specific AWS CLI v2 tag is used so the
# comparison is reproducible; adoption still requires contract + Trivy evidence.
FROM amazon/aws-cli:2.37.5
USER 0
RUN yum install -y diffutils \
    && yum clean all \
    && rm -rf /var/cache/yum \
    && aws --version \
    && diff --version >/dev/null
USER 1000:1000
